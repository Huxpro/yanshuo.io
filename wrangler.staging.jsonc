{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yanshuo-staging",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/1.1/*", "/__admin/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "yanshuo-staging",
    "database_id": "cc8fdda7-5208-400a-9e66-5d6471ed5049",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "yanshuo-staging-decks"}],
  "observability": {"enabled": true},
  "triggers": {"crons": ["0 * * * *"]}
}
